# Aookho Environment Configuration Template
# Copy this file to .env and configure the variables for your environment.
# NEVER commit .env with production credentials to source control.

# Application Environment: 'development', 'testing', or 'production'
ENVIRONMENT=development

# Storage Provider: 'local', 's3', 'r2', or 'minio'
# IMPORTANT: In production, STORAGE_PROVIDER cannot be 'local'. Must be 's3', 'r2', or 'minio'.
STORAGE_PROVIDER=local

# Database Configuration (PostgreSQL in production, SQLite in development)
# Local SQLite example: sqlite:///./aookho.db
DATABASE_URL=sqlite:///./aookho.db

# PostgreSQL Docker Container Configuration
POSTGRES_DB=aookho
POSTGRES_USER=aookho_user
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_PORT=5432


# Authentication / JWT Security
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-random-32-byte-hex-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloud Object Storage (Required when STORAGE_PROVIDER is 's3', 'r2', or 'minio')
# For AWS S3: leave S3_ENDPOINT_URL blank
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# For MinIO: http://localhost:9000
S3_ENDPOINT_URL=
S3_BUCKET_NAME=aookho-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Host URLs
BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# CORS Allowed Origins (Comma-separated in production)
# Wildcards '*' are strictly forbidden in production with credentials
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
